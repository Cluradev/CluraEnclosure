    int32_t map(int32_t x, int32_t in_min, int32_t in_max, int32_t out_min, int32_t out_max) {
        // Linearly map x from [in_min, in_max] to [out_min, out_max]
        return (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
